[Unit]
Description=DebRescueStick independent website and bounded image queue
After=network.target

[Service]
Type=simple
User=debrescuestick
Group=debrescuestick
WorkingDirectory=/opt/debrescuestick/current
EnvironmentFile=/etc/debrescuestick/web.env
ExecStart=/usr/bin/python3 server.py --state /var/lib/debrescuestick/state --port ${DRS_PORT} --origin https://eorls.com
Restart=on-failure
RestartSec=5
UMask=0077
CPUQuota=25%
MemoryMax=128M
MemorySwapMax=0
TasksMax=32
Nice=10
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/debrescuestick/state
ReadOnlyPaths=/var/lib/debrescuestick/state/base
ReadOnlyPaths=-/var/lib/debrescuestick/state/archives
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
