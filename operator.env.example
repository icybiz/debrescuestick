# Copy outside version control and adjust for your own dedicated build host.
# The exact hostname must equal `hostname` on the remote machine.
export DRS_BUILD_HOST=rescue-builder.example.org
export DRS_BUILD_SSH=root@rescue-builder
# Optional: a Node.js >=22 executable for the browser acceptance controller.
export DRS_NODE=node
# Only needed to reproduce the historical, one-time website migration:
export DRS_LEGACY_BASELINE=/path/to/your/website-before
